<script>
/**
 * Handles click events on locked/unlocked cards.
 * Redirects users based on their login and subscription states.
 * @param {Event} event 
 * @param {string} section 
 * @param {string} newsId 
 * @param {boolean} isLoggedIn 
 * @param {boolean} hasSubscription 
 */
function handleCardClick(event, section, newsId, isLoggedIn, hasSubscription) {
  event.preventDefault();

  if (!isLoggedIn) {
    // Redirect to login page
    window.location.href = '/login';
  } else if (!hasSubscription) {
    // Redirect to subscription page
    window.location.href = '/plans';
  } else {
    // Redirect to the news detail page
    window.location.href = `/${section}/${newsId}`;
  }
}
</script>

