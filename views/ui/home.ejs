<script>
// Facebook Blue
const fbBlue = "#1877F2";

// Before like: White hand with blue sleeve and black outline
const beforeLikeSvg = `
<svg width="36" height="36" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg">
  <g transform="translate(4,2)">
    <path d="M14.5 0c-1.3 0-2.4.7-3 1.7-.6-1-1.7-1.7-3-1.7-2.2 0-4 1.8-4 4 0 2.6 2.5 5.5 7.5 9.9 5-4.4 7.5-7.3 7.5-9.9 0-2.2-1.8-4-4-4z" fill="white" stroke="#000" stroke-width="1.5"/>
    <rect x="0" y="18" width="8" height="14" rx="4" fill="${fbBlue}"/>
  </g>
</svg>
`;

// After like: Solid dark blue thumbs-up
const afterLikeSvg = `
<svg width="36" height="36" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg">
  <g transform="translate(4,2)">
    <path d="M14.5 0c-1.3 0-2.4.7-3 1.7-.6-1-1.7-1.7-3-1.7-2.2 0-4 1.8-4 4 0 2.6 2.5 5.5 7.5 9.9 5-4.4 7.5-7.3 7.5-9.9 0-2.2-1.8-4-4-4z" fill="#0d47a1"/>
    <rect x="0" y="18" width="8" height="14" rx="4" fill="#0d47a1"/>
  </g>
</svg>
`;

// Video ID & initial state from EJS
const videoId = "<%= livevideo._id %>";
let hasLiked = <%= hasLiked ? 'true' : 'false' %>;

// Set initial icon on page load
document.getElementById("likeIcon").innerHTML = hasLiked ? afterLikeSvg : beforeLikeSvg;

// Track view on page load
async function trackView() {
  try {
    const res = await fetch(`/api/video/${videoId}/view`, { method: "POST" });
    const data = await res.json();
    if (data.success && data.isNewView) {
      document.getElementById("viewCount").textContent = data.views;
    }
  } catch (err) {
    console.log("View tracking failed:", err);
  }
}

// Share Video
function shareVideo() {
  const videoHeadline = "<%= livevideo.title || 'Live Video' %>";
  const videoLink = window.location.href;
  const shareText = `${videoHeadline}\n\nWatch now: ${videoLink}`;

  if (navigator.share) {
    navigator.share({
      title: videoHeadline,
      text: "Check out this live video!",
      url: videoLink
    }).catch(console.error);
  } else {
    navigator.clipboard.writeText(videoLink).then(() => {
      alert("Link copied to clipboard!");
    }).catch(() => {
      prompt("Copy this link:", videoLink);
    });
  }
}

// Toggle Like - Switch between the two exact SVG icons
async function toggleLike() {
  // Add small bounce animation
  const icon = document.getElementById("likeIcon");
  icon.style.transform = "scale(1.3)";
  setTimeout(() => { icon.style.transform = "scale(1)"; }, 200);

  try {
    const res = await fetch(`/api/video/${videoId}/like`, { method: "POST" });
    const data = await res.json();
    if (data.success) {
      document.getElementById("likeCount").textContent = data.likes;

      // Switch SVG
      document.getElementById("likeIcon").innerHTML = data.hasLiked ? afterLikeSvg : beforeLikeSvg;

      // Update count color
      document.getElementById("likeCount").style.color = data.hasLiked ? fbBlue : "#555";

      hasLiked = data.hasLiked;
    }
  } catch (err) {
    alert("Like failed. Check connection.");
  }
}

// Comment Modal Functions
function openCommentPopup() {
  document.getElementById("commentModal").style.display = "flex";
  loadComments();
}

function closeCommentPopup() {
  document.getElementById("commentModal").style.display = "none";
}

async function submitComment() {
  const message = document.getElementById("commentMessage").value.trim();
  if (!message || message.length > 300) {
    alert("Message required and max 300 characters!");
    return;
  }

  try {
    const res = await fetch(`/api/video/${videoId}/comment`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ message })
    });
    const data = await res.json();

    if (data.success) {
      document.getElementById("commentMessage").value = "";
      document.getElementById("modalCommentCount").textContent = data.commentsCount;
      document.getElementById("commentCountDisplay").textContent = data.commentsCount;
      loadComments();
    }
  } catch (err) {
    alert("Network error.");
  }
}

async function loadComments() {
  try {
    const res = await fetch(`/api/video/${videoId}/stats`);
    const data = await res.json();

    const list = document.getElementById("commentsList");
    list.innerHTML = "";

    if (data.recentComments && data.recentComments.length > 0) {
      data.recentComments.forEach(comment => {
        const div = document.createElement("div");
        div.style = "margin-bottom: 15px; padding-bottom: 10px; border-bottom: 1px solid #eee;";
        div.innerHTML = `
          <strong style="color: #a00000;">${comment.name || 'Anonymous'}</strong>
          <p style="margin: 5px 0; color: #333;">${comment.message}</p>
          <small style="color: #888;">${new Date(comment.createdAt).toLocaleString()}</small>
        `;
        list.appendChild(div);
      });
    } else {
      list.innerHTML = '<p style="text-align: center; color: #999;">No comments yet. Be the first!</p>';
    }

    document.getElementById("modalCommentCount").textContent = data.commentsCount;
    document.getElementById("commentCountDisplay").textContent = data.commentsCount;
  } catch (err) {
    console.error("Failed to load comments:", err);
  }
}

// Auto execute on page load
window.addEventListener("load", () => {
  trackView();
});
</script>

