.mandi-section { margin-bottom: 20px; }
        .mandi-grid { display: flex; flex-wrap: wrap; gap: 20px; }
        .mandi-city { border: 1px solid #ddd; padding: 10px; border-radius: 5px; width: 300px; }
        .mandi-table { width: 100%; border-collapse: collapse; }
        .mandi-table td { border: 1px solid #ddd; padding: 8px; }
        .mandi-table td:first-child { font-weight: bold; }
        #customize-btn { padding: 10px 20px; background-color: #007bff; color: white; border: none; cursor: pointer; border-radius: 5px; }
